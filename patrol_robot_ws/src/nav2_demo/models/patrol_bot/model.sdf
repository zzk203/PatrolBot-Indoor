<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    ====== 巡逻机器人模型 ======
    结构：底盘 + 两个驱动轮 + 万向轮 + 激光雷达
    驱动方式：差速驱动 (DiffDrive Plugin)
  -->
  <model name="patrol_bot">

    <!-- 底盘：0.4m长 × 0.3m宽 × 0.15m高 -->
    <link name="chassis">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.1</iyy><iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry>
          <box><size>0.4 0.3 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.8 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box><size>0.4 0.3 0.15</size></box>
        </geometry>
      </collision>
    </link>

    <!-- 左驱动轮 -->
    <link name="left_wheel">
      <pose>0.12 0.18 -0.02 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
        </material>
      </visual>
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>
    </link>

    <!-- 右驱动轮 -->
    <link name="right_wheel">
      <pose>0.12 -0.18 -0.02 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
        </material>
      </visual>
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
      </collision>
    </link>

    <!-- 万向轮（后方支撑） -->
    <link name="caster">
      <pose>-0.15 0 -0.07 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="caster_visual">
        <geometry>
          <sphere><radius>0.03</radius></sphere>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
        </material>
      </visual>
      <collision name="caster_collision">
        <geometry>
          <sphere><radius>0.03</radius></sphere>
        </geometry>
      </collision>
    </link>

    <!-- 左轮关节 -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>left_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- 右轮关节 -->
    <joint name="right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>right_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- 万向轮关节 -->
    <joint name="caster_joint" type="ball">
      <parent>chassis</parent>
      <child>caster</child>
    </joint>

    <!-- ====== 差速驱动插件 ====== -->
    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/model/patrol_bot/cmd_vel</topic>
      <odom_topic>/model/patrol_bot/odometry</odom_topic>
      <tf_topic>/model/patrol_bot/tf</tf_topic>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
    </plugin>

    <!-- ====== 激光雷达传感器 ====== -->
    <!-- 发布 2D 点云到 /scan_points，后续用 pointcloud_to_laserscan 转 LaserScan -->
    <link name="lidar_link">
      <pose>0.1 0 0.2 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.04</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.8 0.0 1</ambient>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>12.0</max>
            <resolution>0.02</resolution>
          </range>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- LiDAR 刚性连接到底盘 -->
    <joint name="lidar_joint" type="fixed">
      <parent>chassis</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ====== 虚拟相机（RGB 视觉，为 M5 视觉分段预留） ====== -->
    <link name="camera_link">
      <pose>0.18 0 0.22 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box><size>0.03 0.03 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
        </material>
      </visual>
      <sensor name="camera" type="camera">
        <topic>camera/image_raw</topic>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>chassis</parent>
      <child>camera_link</child>
    </joint>

  </model>
</sdf>
