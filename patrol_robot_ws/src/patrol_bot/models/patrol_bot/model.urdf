<?xml version="1.0"?>
<!--
  ====== PatrolBot URDF 模型 ======
  TF 树: base_footprint → base_link → lidar_link
  odom → base_footprint 由 odom_republisher 动态发布
  map  → odom           由 AMCL 发布
-->
<robot name="patrol_bot">
  <material name="blue"><color rgba="0.2 0.2 0.8 1.0"/></material>

  <link name="base_footprint"/>
  <link name="base_link"/>
  <link name="lidar_link"/>
  <link name="camera_link"/>
  <link name="chassis">
    <visual>
      <geometry><box size="0.4 0.3 0.15"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- base_footprint → base_link -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- base_link → chassis -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <!-- base_link → lidar_link: LiDAR 偏心安装 -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.1 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- base_link → camera_link: 相机前方顶部安装 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.18 0 0.12" rpy="0 0 0"/>
  </joint>
</robot>
